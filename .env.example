# Server
PORT=3000
POLL_INTERVAL_MS=300000

# Vast.ai CLI / API
VAST_CLI_PATH=~/Desktop/dev/vast/vast
VAST_API_URL=https://console.vast.ai/api/v0
VAST_API_KEY_PATH=~/.config/vastai/vast_api_key
# Docker Compose uses this host path and always mounts it at the fixed absolute
# in-container path /run/secrets/vast-api-key.
VAST_API_KEY_HOST_PATH=

# Alerts
ALERT_TEMP_THRESHOLD=85
ALERT_IDLE_HOURS=6
ALERT_COOLDOWN_MINUTES=60
ALERT_HOSTNAME_COLLISION_COOLDOWN_MINUTES=360

# Optional admin API auth
ADMIN_API_TOKEN=

# Storage
DB_PATH=./data/vast-monitor.db
DB_SNAPSHOT_RETENTION_DAYS=0
DB_ALERT_RETENTION_DAYS=0
DB_EVENT_RETENTION_DAYS=0

# Optional company/private plugin modules
# Comma-separated paths, relative to project root or absolute
PLUGIN_MODULES=

# Raw market archive extension. It is deliberately disabled unless BOTH values
# are set. DATABASE_URL is the runtime writer DSN; use OWNER_DATABASE_URL only
# with `node scripts/migrate-raw-market.js`.
RAW_ARCHIVE_ENABLED=false
DATABASE_URL=
DATABASE_URL_FILE=
OWNER_DATABASE_URL=
RAW_ARCHIVE_POLL_INTERVAL_MS=300000
RAW_ARCHIVE_REQUEST_TIMEOUT_MS=60000
VAST_OFFERS_URL=https://console.vast.ai/api/v0/bundles/
VAST_GPU_CATALOG_URL=https://console.vast.ai/api/v0/gpu_names/unique/
# Enable with: PLUGIN_MODULES=src/plugins/raw-market/index.js
